{
  "migration_mode": "cutover-complete",
  "active_docs_stack": "astro_starlight",
  "legacy_docs_stack": "sphinx",
  "legacy_retention_policy": "archival_and_redirect_reference_only",
  "search_provider": "algolia-docsearch",
  "sitemap_provider": "@astrojs/sitemap",
  "baseline": {
    "astro": "^6.0.0",
    "starlight": "0.38.4",
    "starlight_versions": "0.5.4",
    "starlight_links_validator": "0.24.0",
    "starlight_docsearch": "0.6.1"
  },
  "scaffold_root": "docs/astro-site",
  "content_inventory": "docs/source/_static/astro_starlight/content_inventory.json",
  "redirect_inventory": "docs/source/_static/astro_starlight/redirect_inventory.json",
  "route_stability_policy": "compatibility-aliases-for-legacy-sphinx-urls",
  "notes": [
    "Astro/Starlight is the active documentation stack.",
    "Legacy Sphinx source is retained as archival and redirect-reference material.",
    "Redirects preserve legacy Sphinx URLs as compatibility aliases.",
    "Algolia DocSearch is the selected search provider when deployment credentials are available."
  ]
}

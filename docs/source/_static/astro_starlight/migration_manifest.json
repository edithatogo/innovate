{
  "migration_mode": "cutover-complete",
  "active_docs_stack": "astro_starlight",
  "legacy_docs_stack": "removed",
  "legacy_retention_policy": "removed",
  "search_provider": "algolia-docsearch",
  "sitemap_provider": "@astrojs/sitemap",
  "baseline": {
    "astro": "^7.0.2",
    "starlight": "0.41.0",
    "starlight_versions": "0.9.0",
    "starlight_links_validator": "0.24.1",
    "starlight_docsearch": "0.7.0"
  },
  "scaffold_root": "docs/astro-site",
  "content_inventory": "docs/source/_static/astro_starlight/content_inventory.json",
  "redirect_inventory": "docs/source/_static/astro_starlight/redirect_inventory.json",
  "route_stability_policy": "astro-native-routes-only",
  "notes": [
    "Astro/Starlight is the only documentation stack.",
    "The former documentation-generator configuration and executable wrappers have been removed.",
    "Route stability is managed by Astro/Starlight content routes.",
    "Algolia DocSearch is the selected search provider when deployment credentials are available."
  ]
}

easyblock = "PythonPackage"

name = "innovate"
version = "0.5.0"

toolchain = {"name": "foss", "version": "2024a"}
download_dep_fail = True
use_pip = True
sanity_pip_check = True

sanity_check_commands = [
    "python -m pip check",
    "python -c \"import innovate; print(innovate.__version__)\"",
]

sanity_check_paths = {
    "files": [],
    "dirs": ["lib/python%(pyshortver)s/site-packages/innovate"],
}

# Optional module sanity coverage can be layered on top of this candidate once
# the package is exercised in a real EasyBuild environment.

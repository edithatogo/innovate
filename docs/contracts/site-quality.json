{
  "schema_version": 1,
  "origin": "https://edithatogo.github.io",
  "base": "/innovate/",
  "required_routes": [
    "/",
    "/user-guide/getting-started/",
    "/api/python/",
    "/latest/",
    "/latest/api/python/",
    "/native-migration/",
    "/maintainers/documentation-quality/",
    "/api/generated/julia/",
    "/api/generated/r/",
    "/models/",
    "/tutorials/",
    "/historical-documentation/",
    "/operations/documentation-standards/",
    "/maintainers/language-conventions/",
    "/tutorials/public-data-fit/",
    "/tutorials/marimo/"
  ],
  "source_roots": [
    "docs/astro-site",
    "docs/contracts",
    "bindings/python/innovate",
    "examples",
    "scripts/check_api_documentation.py",
    "scripts/check_native_documentation.py",
    "scripts/check_documentation_content.py",
    "scripts/check_scientific_review_contract.py",
    "scripts/verify_production_docs.py",
    ".github/workflows/docs.yml",
    "bindings/julia/src",
    "bindings/r/R",
    "bindings/r/man",
    "bindings/r/NAMESPACE",
    "scripts/check_polyglot_api_documentation.py",
    "scripts/generate_api_reference.py",
    "scripts/check_julia_documentation.jl",
    "scripts/check_r_documentation.R",
    ".github/workflows/ci.yml",
    "scripts/check_retired_documentation.py",
    "scripts/check_community_documentation.py",
    "scripts/generate_learning_catalogue.py",
    "scripts/check_learning_notebooks.py",
    "docs/datasets",
    "notebooks",
    "rust/crates/innovate-core/src/discovery.json",
    "Cargo.toml",
    "Cargo.lock",
    "rust/crates/innovate-core/Cargo.toml",
    "rust/crates/innovate-core/src",
    "rust/crates/innovate-demand/Cargo.toml",
    "rust/crates/innovate-demand/src",
    "rust/crates/innovate-tabular/Cargo.toml",
    "rust/crates/innovate-tabular/src",
    "rust/crates/innovate-ffi/Cargo.toml",
    "rust/crates/innovate-ffi/src",
    "rust/crates/innovate-python/Cargo.toml",
    "rust/crates/innovate-python/src",
    "rust/crates/innovate-kairos/Cargo.toml",
    "rust/crates/innovate-kairos/src",
    "rust/crates/innovate-games/Cargo.toml",
    "rust/crates/innovate-games/src",
    "rust/crates/innovate-games/Cargo.lock"
  ],
  "exclude_source_parts": [
    "node_modules",
    "dist",
    ".astro",
    ".reports",
    "__pycache__",
    ".venv",
    "__marimo__"
  ],
  "max_html_bytes": 2000000,
  "retired_documentation": "docs/contracts/retired-documentation.json"
}

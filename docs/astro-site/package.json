{
  "name": "innovate-docs",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-api.mjs && astro build",
    "check": "node scripts/generate-api.mjs --check && astro check",
    "test": "node --test scripts/*.test.mjs",
    "dev": "node scripts/generate-api.mjs && astro dev",
    "preview": "astro preview",
    "test:browser": "playwright test",
    "test:browser:list": "playwright test --list --reporter=list"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.8",
    "@astrojs/starlight": "^0.43.0",
    "@astrojs/starlight-docsearch": "^0.8.2",
    "astro": "^7.4.11",
    "starlight-links-validator": "^0.27.0",
    "starlight-polyglot": "file:vendor/starlight-polyglot"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@emnapi/runtime": "1.11.3",
    "@playwright/test": "1.65.1",
    "axe-core": "4.14.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}

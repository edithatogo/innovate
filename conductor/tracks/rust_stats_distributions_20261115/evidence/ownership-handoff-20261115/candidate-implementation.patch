+//! Read one versioned request per line and emit the actual native response.
+//!
+//! Compile against the exact recorded baseline revision when reproducing
+//! behavior-baseline.json. This is a capture tool, not a mathematical oracle.
+use std::io::{self, BufRead};
+
+fn main() {
+    for line in io::stdin().lock().lines() {
+        println!("{}", innovate_core::execute_json(&line.unwrap()));
+    }
+}

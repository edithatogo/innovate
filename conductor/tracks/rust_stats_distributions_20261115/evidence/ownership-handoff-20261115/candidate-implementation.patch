+#[test]
+fn statrs_migration_long_and_piecewise_constant_splits_keep_null_diagnostics() {
+    for draws in [80, 10_000] {
+        let half = draws / 2;
+        let piecewise = |left, right| {
+            std::iter::repeat_n(left, half)
+                .chain(std::iter::repeat_n(right, half))
+                .collect::<Vec<f64>>()
+        };
+        for chains in [
+            json!([vec![0.; draws], vec![1.; draws]]),
+            json!([piecewise(0., 1.), piecewise(2., 3.)]),
+        ] {
+            let rhat = execute(
+                "bayesian_split_rhat",
+                json!({"method":"rank_normalized_split_rhat", "chains":chains}),
+            );
+            assert!(rhat["error"].is_null(), "{rhat}");
+            for key in ["rhat", "bulk_rhat", "folded_rhat"] {
+                assert!(rhat["result"][key].is_null(), "draws={draws} {key}: {rhat}");
+            }
+            let ess = execute("bayesian_effective_sample_size", json!({"chains":chains}));
+            assert!(ess["error"].is_null(), "{ess}");
+            assert_eq!(ess["result"]["draws_used"], 2 * draws);
+            for key in ["bulk_ess", "lower_tail_ess", "upper_tail_ess", "tail_ess"] {
+                assert!(ess["result"][key].is_null(), "draws={draws} {key}: {ess}");
+            }
+        }
+    }
+}

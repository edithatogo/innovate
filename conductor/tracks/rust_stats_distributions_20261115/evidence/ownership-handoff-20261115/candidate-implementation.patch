+mod distribution_dependency {
+    use super::*;
+    use statrs::distribution::{Continuous, ContinuousCDF, Normal};
+
+    fn reference() -> Value {
+        serde_json::from_str(include_str!("fixtures/statrs_20261115/normal.json")).unwrap()
+    }
+
+    fn number(value: &Value) -> f64 {
+        match value.as_str() {
+            Some("-inf") => f64::NEG_INFINITY,
+            Some("inf") => f64::INFINITY,
+            Some("nan") => f64::NAN,
+            Some(tag) => panic!("unknown reference number {tag}"),
+            None => value.as_f64().expect("numeric reference"),
+        }
+    }
+
+    fn reference_error(actual: f64, expected: f64, case: &Value) -> Option<String> {
+        let tolerance =
+            number(&case["abs_tol"]) + case["rel_tol"].as_f64().unwrap_or(0.) * expected.abs();
+        let matches = if expected.is_nan() {
+            actual.is_nan()
+        } else if expected.is_infinite() || expected == 0. {
+            actual == expected
+        } else {
+            actual.is_finite() && (actual - expected).abs() <= tolerance
+        };
+        (!matches).then(|| {
+            format!(
+                "{}: actual={actual:.17e}, expected={expected:.17e}, tolerance={tolerance:.17e}",
+                case["id"]
+            )
+        })
+    }
+
+    fn assert_reference(actual: f64, expected: f64, case: &Value) {
+        if let Some(error) = reference_error(actual, expected, case) {
+            panic!("{error}");
+        }
+    }
+
+    #[test]
+    fn statrs_migration_distribution_quantiles_match_independent_tails_and_endpoints() {
+        let data = reference();
+        let cases = data["normal_quantile"].as_array().unwrap();
+        assert_eq!(cases.len(), 22);
+        let normal = Normal::standard();
+        for case in cases {
+            let probability = number(&case["p"]);
+            let actual = normal.inverse_cdf(probability);
+            assert_reference(actual, number(&case["expected"]), case);
+            assert_eq!(normal.try_inverse_cdf(probability).unwrap(), actual);
+        }
+    }
+
+    #[test]
+    fn statrs_migration_distribution_cdf_and_survival_preserve_tiny_tails() {
+        let data = reference();
+        let cases = data["normal_cdf"].as_array().unwrap();
+        assert_eq!(cases.len(), 18);
+        let normal = Normal::standard();
+        let mut failures = Vec::new();
+        for case in cases {
+            let value = number(&case["x"]);
+            for (operation, actual, expected) in [
+                ("cdf", normal.cdf(value), number(&case["expected"])),
+                ("survival", normal.sf(value), number(&case["survival"])),
+            ] {
+                if let Some(error) = reference_error(actual, expected, case) {
+                    failures.push(format!("{operation} {error}"));
+                }
+            }
+        }
+        assert!(
+            failures.is_empty(),
+            "all 36 CDF/survival comparisons executed; failures:\n{}",
+            failures.join("\n")
+        );
+    }
+
+    #[test]
+    fn statrs_migration_distribution_log_pdf_keeps_extreme_scales_finite() {
+        let data = reference();
+        let cases = data["normal_log_pdf"].as_array().unwrap();
+        assert_eq!(cases.len(), 18);
+        for case in cases {
+            let normal = Normal::new(number(&case["mean"]), number(&case["sd"])).unwrap();
+            assert_reference(
+                normal.ln_pdf(number(&case["x"])),
+                number(&case["expected"]),
+                case,
+            );
+        }
+    }
+
+    #[test]
+    fn statrs_migration_distribution_rejects_invalid_probability_and_scale() {
+        let normal = Normal::standard();
+        for probability in [
+            -1.,
+            -f64::MIN_POSITIVE,
+            1. + f64::EPSILON,
+            f64::INFINITY,
+            f64::NEG_INFINITY,
+            f64::NAN,
+        ] {
+            // In statrs 0.19.1 the default try_inverse_cdf delegates to the
+            // panicking inverse_cdf; Result does not imply input validation.
+            assert!(
+                std::panic::catch_unwind(|| normal.inverse_cdf(probability)).is_err(),
+                "{probability}"
+            );
+            assert!(
+                std::panic::catch_unwind(|| normal.try_inverse_cdf(probability)).is_err(),
+                "{probability}"
+            );
+        }
+        for sd in [0., -0., -1., f64::NAN] {
+            assert!(Normal::new(0., sd).is_err(), "{sd}");
+        }
+        assert!(Normal::new(f64::NAN, 1.).is_err());
+        // Innovate's stricter finite JSON and positive-noise contracts are
+        // independently exercised above; they are not delegated to statrs.
+    }

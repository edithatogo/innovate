   "source": [
    "# Run comparison scenarios\n",
    "scenarios = [\n",
    "    ('bass_with_noise', 'Bass Model with Noise'),\n",
    "    ('logistic_with_outliers', 'Logistic Model with Outliers'),\n",
    "    ('gompertz_seasonal', 'Gompertz Model with Seasonality')\n",
    "]\n",
    "\n",
    "scenario_results = {}\n",
    "\n",
    "fig, axes = plt.subplots(3, 3, figsize=(18, 15))\n",
    "\n",
    "for i, (scenario_key, scenario_name) in enumerate(scenarios):\n",
    "    print(f\"\\n=== ANALYZING SCENARIO: {scenario_name.upper()} ===\")\n",
    "    \n",
    "    # Generate test data\n",
    "    time_pts, noisy_data, clean_data = comparator.generate_test_dataset(scenario_key)\n",
    "    \n",
    "    # Split data for validation\n",
    "    train_size = int(len(time_pts) * 0.8)\n",
    "    train_time = time_pts[:train_size]\n",
    "    train_data = noisy_data[:train_size]\n",
    "    val_time = time_pts[train_size:]\n",
    "    val_data = noisy_data[train_size:]\n",
    "    \n",
    "    # Fit models\n",
    "    comparator.fit_all_models(train_time, train_data)\n",
    "    \n",
    "    # Evaluate models\n",
    "    comparator.evaluate_models(train_time, train_data, val_time, val_data)\n",
    "    \n",
    "    # Rank models\n",
    "    ranked_models, model_scores = comparator.rank_models()\n",
    "    \n",
    "    # Store results\n",
    "    scenario_results[scenario_name] = {\n",
    "        'rankings': ranked_models,\n",
    "        'scores': model_scores,\n",
    "        'evaluations': comparator.evaluation_results.copy(),\n",
    "        'fitted_models': comparator.fitted_models.copy()\n",
    "    }\n",
    "    \n",
    "    print(f\"\\nModel Rankings for {scenario_name}:\")\n",
    "    for rank, (model_name, score) in enumerate(ranked_models, 1):\n",
    "        print(f\"  {rank}. {model_name} (Score: {score:.3f})\")\n",
    "    \n",
    "    # Plot results for this scenario\n",
    "    # Data plot\n",
    "    ax_data = axes[i, 0]\n",
    "    ax_data.plot(time_pts, clean_data, 'k--', linewidth=2, label='True Data', alpha=0.7)\n",
    "    ax_data.plot(train_time, train_data, 'bo', markersize=4, label='Training Data', alpha=0.7)\n",
    "    ax_data.plot(val_time, val_data, 'ro', markersize=4, label='Validation Data', alpha=0.7)\n",
    "    ax_data.set_title(f'{scenario_name}\\nData')\n",
    "    ax_data.legend()\n",
    "    ax_data.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Model fits plot\n",
    "    ax_fits = axes[i, 1]\n",
    "    ax_fits.plot(time_pts, clean_data, 'k--', linewidth=2, label='True Data', alpha=0.5)\n",
    "    ax_fits.scatter(train_time, train_data, c='blue', s=20, alpha=0.6, label='Training')\n",
    "    \n",
    "    colors_fit = ['red', 'green', 'orange']\n",
    "    for j, (model_name, model) in enumerate(comparator.fitted_models.items()):\n",
    "        full_predictions = model.predict(time_pts)\n",
    "        ax_fits.plot(time_pts, full_predictions, color=colors_fit[j], \n",
    "                    linewidth=2, label=f'{model_name} Fit')\n",
    "    \n",
    "    ax_fits.set_title('Model Fits')\n",
    "    ax_fits.legend()\n",
    "    ax_fits.grid(True, alpha=0.3)\n",
    "    \n",
    "    # Ranking plot\n",
    "    ax_rank = axes[i, 2]\n",
    "    model_names = [name for name, _ in ranked_models]\n",
    "    scores = [score for _, score in ranked_models]\n",
    "    bars = ax_rank.bar(model_names, scores, color=colors_fit[:len(model_names)])\n",
    "    \n",
    "    # Add score labels\n",
    "    for bar, score in zip(bars, scores):\n",

    "# Create decision framework\n",
    "class ModelSelectionGuide:\n",
    "    \"\"\"\n",
    "    Interactive guide for model selection based on user requirements\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self):\n",
    "        self.decision_tree = {\n",
    "            'data_characteristics': {\n",
    "                'high_quality': {\n",
    "                    'single_product': ['Bass', 'Logistic', 'Gompertz'],\n",
    "                    'multiple_products': ['MultiProduct', 'NortonBass'],\n",
    "                    'generational': ['NortonBass']\n",
    "                },\n",
    "                'noisy_data': {\n",
    "                    'simple_pattern': ['Logistic'],\n",
    "                    'complex_pattern': ['Bass', 'Gompertz']\n",
    "                },\n",
    "                'limited_data': {\n",
    "                    'early_stage': ['Logistic', 'Bass'],\n",
    "                    'mature_stage': ['Gompertz']\n",
    "                }\n",
    "            },\n",
    "            'business_context': {\n",
    "                'technology_adoption': ['Bass'],\n",
    "                'market_penetration': ['Logistic'],\n",
    "                'biological_growth': ['Gompertz'],\n",
    "                'competition': ['MultiProduct'],\n",
    "                'replacement_cycle': ['NortonBass']\n",
    "            },\n",
    "            'analysis_requirements': {\n",
    "                'high_interpretability': ['Bass', 'Logistic'],\n",
    "                'accurate_forecasting': ['Bass', 'Gompertz'],\n",
    "                'parameter_insights': ['Bass'],\n",
    "                'simple_implementation': ['Logistic']\n",
    "            }\n",
    "        }\n",
    "    \n",
    "    def recommend_models(self, **criteria):\n",
    "        \"\"\"\n",
    "        Recommend models based on specified criteria\n",
    "        \"\"\"\n",
    "        recommendations = set()\n",
    "        reasoning = []\n",
    "        \n",
    "        for category, subcategories in self.decision_tree.items():\n",
    "            for criterion_key, criterion_value in criteria.items():\n",
    "                if criterion_key in subcategories:\n",
    "                    models = subcategories[criterion_key]\n",
    "                    if isinstance(models, dict) and criterion_value in models:\n",
    "                        recommended = models[criterion_value]\n",
    "                        recommendations.update(recommended)\n",
    "                        reasoning.append(f\"Based on {criterion_key}={criterion_value}: {recommended}\")\n",
    "                    elif isinstance(models, list):\n",
    "                        recommendations.update(models)\n",
    "                        reasoning.append(f\"Based on {criterion_key}: {models}\")\n",
    "        \n",
    "        return list(recommendations), reasoning\n",
    "    \n",
    "    def create_selection_matrix(self):\n",
    "        \"\"\"\n",
    "        Create a comprehensive model selection matrix\n",
    "        \"\"\"\n",
    "        criteria = [\n",
    "            'Data Quality Requirements',\n",
    "            'Interpretability',\n",
    "            'Forecasting Accuracy', \n",
    "            'Implementation Complexity',\n",
    "            'Parameter Insights',\n",
    "            'Computational Cost'\n",
    "        ]\n",
    "        \n",
    "        models = ['Bass', 'Logistic', 'Gompertz', 'MultiProduct', 'NortonBass']\n",
    "        \n",
    "        # Scoring matrix (1-5 scale, 5 = excellent)\n",
    "        scores = {\n",
    "            'Bass': [4, 5, 5, 3, 5, 4],\n",
    "            'Logistic': [3, 5, 3, 5, 3, 5],\n",
    "            'Gompertz': [4, 4, 4, 3, 3, 4],\n",
    "            'MultiProduct': [5, 3, 4, 2, 4, 2],\n",
    "            'NortonBass': [5, 3, 4, 2, 4, 2]\n",
    "        }\n",
    "        \n",
    "        return pd.DataFrame(scores, index=criteria).T\n",
    "\n",
    "# Initialize selection guide\n",
    "guide = ModelSelectionGuide()\n",
    "\n",
    "# Create and display selection matrix\n",
    "selection_matrix = guide.create_selection_matrix()\n",
    "\n",
    "print(\"=== MODEL SELECTION MATRIX ===\")\n",
    "print(\"Scale: 1 (Poor) to 5 (Excellent)\\n\")\n",
    "print(selection_matrix)\n",
    "\n",
    "# Visualize selection matrix\n",
    "plt.figure(figsize=(12, 8))\n",
    "sns.heatmap(selection_matrix, annot=True, cmap='RdYlGn', center=3, \n",
    "           cbar_kws={'label': 'Score (1-5)'}, fmt='d')\n",
    "plt.title('Model Selection Matrix')\n",
    "plt.xlabel('Selection Criteria')\n",
    "plt.ylabel('Diffusion Models')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Example recommendations\n",
    "print(\"\\n=== EXAMPLE RECOMMENDATIONS ===\")\n",
    "\n",
    "example_scenarios = [\n",
    "    {\n",
    "        'scenario': 'New Product Launch',\n",
    "        'criteria': {'business_context': 'technology_adoption', \n",
    "                    'analysis_requirements': 'parameter_insights'}\n",
    "    },\n",
    "    {\n",
    "        'scenario': 'Market Penetration Analysis', \n",
    "        'criteria': {'business_context': 'market_penetration',\n",
    "                    'analysis_requirements': 'simple_implementation'}\n",
    "    },\n",
    "    {\n",
    "        'scenario': 'Platform Competition Study',\n",
    "        'criteria': {'business_context': 'competition'}\n",
    "    }\n",
    "]\n",
    "\n",
    "for scenario in example_scenarios:\n",
    "    recommended_models, reasoning = guide.recommend_models(**scenario['criteria'])\n",
    "    print(f\"\\n{scenario['scenario']}:\")\n",
    "    print(f\"  Recommended Models: {', '.join(recommended_models)}\")\n",
    "    print(f\"  Reasoning: {'; '.join(reasoning)}\")"
   ]

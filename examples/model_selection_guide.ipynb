    "# Time series cross-validation for model selection\n",
    "def time_series_cross_validation(models, time_points, adoption_data, n_splits=5):\n",
    "    \"\"\"\n",
    "    Perform time series cross-validation for model selection\n",
    "    \"\"\"\n",
    "    tscv = TimeSeriesSplit(n_splits=n_splits)\n",
    "    cv_results = {model_name: [] for model_name in models.keys()}\n",
    "    \n",
    "    fitter = ScipyFitter()\n",
    "    \n",
    "    for fold, (train_idx, test_idx) in enumerate(tscv.split(time_points)):\n",
    "        train_time = time_points[train_idx]\n",
    "        train_data = adoption_data[train_idx]\n",
    "        test_time = time_points[test_idx]\n",
    "        test_data = adoption_data[test_idx]\n",
    "        \n",
    "        print(f\"\\nFold {fold + 1}: Train size={len(train_idx)}, Test size={len(test_idx)}\")\n",
    "        \n",
    "        for model_name, model_class in models.items():\n",
    "            try:\n",
    "                # Create fresh model instance\n",
    "                if model_name == 'Bass':\n",
    "                    model = BassModel()\n",
    "                elif model_name == 'Logistic':\n",
    "                    model = LogisticModel()\n",
    "                elif model_name == 'Gompertz':\n",
    "                    model = GompertzModel()\n",
    "                else:\n",
    "                    continue\n",
    "                \n",
    "                # Fit on training data\n",
    "                fitter.fit(model, train_time, train_data)\n",
    "                \n",
    "                # Predict on test data\n",
    "                predictions = model.predict(test_time)\n",
    "                \n",
    "                # Calculate metrics\n",
    "                rmse = np.sqrt(mean_squared_error(test_data, predictions))\n",
    "                mae = mean_absolute_error(test_data, predictions)\n",
    "                r2 = calculate_r_squared(test_data, predictions)\n",
    "                \n",
    "                cv_results[model_name].append({\n",
    "                    'fold': fold + 1,\n",
    "                    'rmse': rmse,\n",
    "                    'mae': mae,\n",
    "                    'r2': r2\n",
    "                })\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"  {model_name} failed in fold {fold + 1}: {e}\")\n",
    "                cv_results[model_name].append({\n",
    "                    'fold': fold + 1,\n",
    "                    'rmse': np.inf,\n",
    "                    'mae': np.inf,\n",
    "                    'r2': -np.inf\n",
    "                })\n",
    "    \n",
    "    return cv_results\n",
    "\n",
    "# Generate comprehensive test dataset\n",
    "np.random.seed(42)\n",
    "time_points = np.arange(1, 41)  # 40 time points\n",
    "\n",
    "# Generate mixed scenario (Bass model with noise and slight seasonality)\n",
    "true_bass = BassModel(p=0.025, q=0.42, m=1200)\n",
    "clean_adoptions = true_bass.predict(time_points)\n",
    "\n",
    "# Add noise and seasonality\n",
    "noise = np.random.normal(0, 0.04 * clean_adoptions)\n",
    "seasonality = 0.08 * clean_adoptions * np.sin(2 * np.pi * time_points / 12)\n",
    "test_adoptions = clean_adoptions + noise + seasonality\n",
    "test_adoptions = np.maximum(0, test_adoptions)\n",
    "\n",
    "# Define models for comparison\n",
    "models_to_test = {\n",
    "    'Bass': BassModel,\n",
    "    'Logistic': LogisticModel,\n",
    "    'Gompertz': GompertzModel\n",
    "}\n",
    "\n",
    "# Perform cross-validation\n",
    "print(\"=== TIME SERIES CROSS-VALIDATION ===\")\n",
    "cv_results = time_series_cross_validation(models_to_test, time_points, test_adoptions, n_splits=5)\n",
    "\n",
    "# Analyze cross-validation results\n",
    "print(\"\\n=== CROSS-VALIDATION SUMMARY ===\")\n",
    "cv_summary = {}\n",
    "\n",
    "for model_name, results in cv_results.items():\n",
    "    if results and all(r['rmse'] != np.inf for r in results):\n",
    "        rmse_scores = [r['rmse'] for r in results]\n",
    "        r2_scores = [r['r2'] for r in results]\n",
    "        \n",
    "        cv_summary[model_name] = {\n",
    "            'mean_rmse': np.mean(rmse_scores),\n",
    "            'std_rmse': np.std(rmse_scores),\n",
    "            'mean_r2': np.mean(r2_scores),\n",
    "            'std_r2': np.std(r2_scores)\n",
    "        }\n",
    "        \n",
    "        print(f\"{model_name}:\")\n",
    "        print(f\"  RMSE: {cv_summary[model_name]['mean_rmse']:.2f} ± {cv_summary[model_name]['std_rmse']:.2f}\")\n",
    "        print(f\"  R²: {cv_summary[model_name]['mean_r2']:.3f} ± {cv_summary[model_name]['std_r2']:.3f}\")\n",
    "\n",
    "# Visualize cross-validation results\n",
    "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))\n",
    "\n",
    "# RMSE comparison\n",
    "model_names = list(cv_summary.keys())\n",
    "rmse_means = [cv_summary[name]['mean_rmse'] for name in model_names]\n",
    "rmse_stds = [cv_summary[name]['std_rmse'] for name in model_names]\n",
    "\n",
    "bars1 = ax1.bar(model_names, rmse_means, yerr=rmse_stds, capsize=5, \n",
    "               color=['blue', 'red', 'green'], alpha=0.7)\n",
    "ax1.set_title('Cross-Validation RMSE Comparison')\n",
    "ax1.set_ylabel('RMSE')\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Add value labels\n",
    "for bar, mean_val in zip(bars1, rmse_means):\n",
    "    ax1.text(bar.get_x() + bar.get_width()/2., bar.get_height() + max(rmse_stds) * 0.1,\n",
    "             f'{mean_val:.1f}', ha='center', va='bottom')\n",
    "\n",
    "# R² comparison  \n",
    "r2_means = [cv_summary[name]['mean_r2'] for name in model_names]\n",
    "r2_stds = [cv_summary[name]['std_r2'] for name in model_names]\n",
    "\n",
    "bars2 = ax2.bar(model_names, r2_means, yerr=r2_stds, capsize=5,\n",
    "               color=['blue', 'red', 'green'], alpha=0.7)\n",
    "ax2.set_title('Cross-Validation R² Comparison')\n",
    "ax2.set_ylabel('R² Score')\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "# Add value labels\n",
    "for bar, mean_val in zip(bars2, r2_means):\n",
    "    ax2.text(bar.get_x() + bar.get_width()/2., bar.get_height() + max(r2_stds) * 0.1,\n",
    "             f'{mean_val:.3f}', ha='center', va='bottom')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Statistical significance testing\n",
    "print(\"\\n=== STATISTICAL SIGNIFICANCE TESTING ===\")\n",
    "if len(model_names) >= 2:\n",
    "    from scipy.stats import ttest_ind\n",
    "    \n",
    "    # Compare top two models\n",
    "    best_model = min(model_names, key=lambda x: cv_summary[x]['mean_rmse'])\n",
    "    other_models = [name for name in model_names if name != best_model]\n",
    "    \n",
    "    print(f\"Best model by RMSE: {best_model}\")\n",
    "    \n",
    "    for other_model in other_models:\n",
    "        best_rmse = [r['rmse'] for r in cv_results[best_model]]\n",
    "        other_rmse = [r['rmse'] for r in cv_results[other_model]]\n",
    "        \n",
    "        t_stat, p_value = ttest_ind(best_rmse, other_rmse)\n",
    "        significance = \"significant\" if p_value < 0.05 else \"not significant\"\n",
    "        \n",
    "        print(f\"  {best_model} vs {other_model}: p-value = {p_value:.4f} ({significance})\")"
   ]
  },

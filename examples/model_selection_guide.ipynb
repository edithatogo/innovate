    "# Generate theoretical curves for model comparison\n",
    "def generate_theoretical_curves():\n",
    "    \"\"\"\n",
    "    Generate theoretical curves for all single-product models\n",
    "    \"\"\"\n",
    "    time_points = np.linspace(0.1, 20, 100)\n",
    "    curves = {}\n",
    "    \n",
    "    # Bass Model\n",
    "    bass = BassModel(p=0.02, q=0.35, m=1000)\n",
    "    curves['Bass'] = bass.predict(time_points)\n",
    "    \n",
    "    # Logistic Model  \n",
    "    logistic = LogisticModel(L=1000, k=0.3, x0=10)\n",
    "    curves['Logistic'] = logistic.predict(time_points)\n",
    "    \n",
    "    # Gompertz Model\n",
    "    gompertz = GompertzModel(a=1000, b=2, c=0.8)\n",
    "    curves['Gompertz'] = gompertz.predict(time_points)\n",
    "    \n",
    "    return time_points, curves\n",
    "\n",
    "# Generate and plot theoretical curves\n",
    "time_pts, theoretical_curves = generate_theoretical_curves()\n",
    "\n",
    "# Create comprehensive comparison plot\n",
    "fig, ((ax1, ax2), (ax3, ax4)) = plt.subplots(2, 2, figsize=(16, 12))\n",
    "\n",
    "# Plot 1: Cumulative adoption curves\n",
    "colors = ['blue', 'red', 'green']\n",
    "for i, (model_name, curve) in enumerate(theoretical_curves.items()):\n",
    "    ax1.plot(time_pts, curve, color=colors[i], linewidth=3, label=model_name)\n",
    "\n",
    "ax1.set_title('Cumulative Adoption Curves Comparison')\n",
    "ax1.set_xlabel('Time')\n",
    "ax1.set_ylabel('Cumulative Adoptions')\n",
    "ax1.legend()\n",
    "ax1.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 2: Growth rates (derivatives)\n",
    "for i, (model_name, curve) in enumerate(theoretical_curves.items()):\n",
    "    growth_rate = np.gradient(curve, time_pts)\n",
    "    ax2.plot(time_pts, growth_rate, color=colors[i], linewidth=3, label=f'{model_name} Growth Rate')\n",
    "\n",
    "ax2.set_title('Adoption Rate Comparison')\n",
    "ax2.set_xlabel('Time')\n",
    "ax2.set_ylabel('New Adoptions per Time Unit')\n",
    "ax2.legend()\n",
    "ax2.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 3: Normalized curves (0-1 scale)\n",
    "for i, (model_name, curve) in enumerate(theoretical_curves.items()):\n",
    "    normalized_curve = curve / curve.max()\n",
    "    ax3.plot(time_pts, normalized_curve, color=colors[i], linewidth=3, label=f'{model_name} (Normalized)')\n",
    "\n",
    "ax3.set_title('Normalized Curves (Shape Comparison)')\n",
    "ax3.set_xlabel('Time')\n",
    "ax3.set_ylabel('Adoption Progress (0-1)')\n",
    "ax3.legend()\n",
    "ax3.grid(True, alpha=0.3)\n",
    "\n",
    "# Plot 4: Model characteristics radar chart\n",
    "characteristics = ['Complexity', 'Interpretability', 'Flexibility', 'Early_Fit', 'Late_Fit']\n",
    "model_scores = {\n",
    "    'Bass': [3, 5, 4, 5, 4],\n",
    "    'Logistic': [2, 5, 3, 3, 3], \n",
    "    'Gompertz': [3, 4, 4, 3, 5]\n",
    "}\n",
    "\n",
    "angles = np.linspace(0, 2 * np.pi, len(characteristics), endpoint=False).tolist()\n",
    "angles += angles[:1]  # Complete the circle\n",
    "\n",
    "ax4 = plt.subplot(2, 2, 4, projection='polar')\n",
    "for i, (model_name, scores) in enumerate(model_scores.items()):\n",
    "    scores += scores[:1]  # Complete the circle\n",
    "    ax4.plot(angles, scores, color=colors[i], linewidth=2, label=model_name)\n",
    "    ax4.fill(angles, scores, color=colors[i], alpha=0.25)\n",
    "\n",
    "ax4.set_xticks(angles[:-1])\n",
    "ax4.set_xticklabels(characteristics)\n",
    "ax4.set_ylim(0, 5)\n",
    "ax4.set_title('Model Characteristics Comparison')\n",
    "ax4.legend()\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Calculate and display curve statistics\n",
    "print(\"\\n=== CURVE STATISTICS ===\")\n",
    "for model_name, curve in theoretical_curves.items():\n",
    "    growth_rate = np.gradient(curve, time_pts)\n",
    "    peak_growth_idx = np.argmax(growth_rate)\n",
    "    peak_growth_time = time_pts[peak_growth_idx]\n",
    "    peak_growth_rate = growth_rate[peak_growth_idx]\n",
    "    \n",
    "    # Find inflection point (50% of maximum)\n",
    "    half_max = curve.max() * 0.5\n",
    "    inflection_idx = np.argmin(np.abs(curve - half_max))\n",
    "    inflection_time = time_pts[inflection_idx]\n",
    "    \n",
    "    print(f\"{model_name}:\")\n",
    "    print(f\"  Peak growth at t={peak_growth_time:.1f} (rate={peak_growth_rate:.1f})\")\n",
    "    print(f\"  Inflection point at t={inflection_time:.1f}\")\n",
    "    print(f\"  Final adoption: {curve[-1]:.0f}\")\n",
    "    print()"
   ]

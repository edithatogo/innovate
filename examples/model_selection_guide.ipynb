    "    \n",
    "    ax_rank.set_title('Model Rankings')\n",
    "    ax_rank.set_ylabel('Composite Score')\n",
    "    ax_rank.set_ylim(0, max(scores) * 1.2)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"

    "## 3. Systematic Model Comparison Framework\n",
    "\n",
    "Here's a systematic approach to compare models on your specific dataset using multiple evaluation criteria."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create comprehensive model comparison framework\n",
    "class ModelComparison:\n",
    "    \"\"\"\n",
    "    Comprehensive framework for comparing diffusion models\n",
    "    \"\"\"\n",
    "    \n",
    "    def __init__(self, models_to_compare=None):\n",
    "        if models_to_compare is None:\n",
    "            self.models_to_compare = ['Bass', 'Logistic', 'Gompertz']\n",
    "        else:\n",
    "            self.models_to_compare = models_to_compare\n",
    "        \n",
    "        self.fitted_models = {}\n",
    "        self.evaluation_results = {}\n",
    "        self.fitter = ScipyFitter()\n",
    "    \n",
    "    def generate_test_dataset(self, scenario='bass_with_noise'):\n",
    "        \"\"\"\n",
    "        Generate test dataset for model comparison\n",
    "        \"\"\"\n",
    "        time_points = np.arange(1, 51)\n",
    "        \n",
    "        if scenario == 'bass_with_noise':\n",
    "            # Generate Bass model data with realistic noise\n",
    "            true_bass = BassModel(p=0.03, q=0.38, m=1000)\n",
    "            clean_data = true_bass.predict(time_points)\n",
    "            noise = np.random.normal(0, 0.05 * clean_data)\n",
    "            noisy_data = clean_data + noise\n",
    "            noisy_data = np.maximum(0, noisy_data)\n",
    "            \n",
    "        elif scenario == 'logistic_with_outliers':\n",
    "            # Generate Logistic data with outliers\n",
    "            true_logistic = LogisticModel(L=1000, k=0.2, x0=25)\n",
    "            clean_data = true_logistic.predict(time_points)\n",
    "            # Add outliers\n",
    "            outlier_indices = np.random.choice(len(time_points), 5, replace=False)\n",
    "            noisy_data = clean_data.copy()\n",
    "            noisy_data[outlier_indices] *= np.random.uniform(0.5, 1.5, 5)\n",
    "            \n",
    "        elif scenario == 'gompertz_seasonal':\n",
    "            # Generate Gompertz data with seasonal pattern\n",
    "            true_gompertz = GompertzModel(a=1000, b=2, c=0.8)\n",
    "            clean_data = true_gompertz.predict(time_points)\n",
    "            seasonal = 0.1 * clean_data * np.sin(2 * np.pi * time_points / 12)\n",
    "            noisy_data = clean_data + seasonal\n",
    "            \n",
    "        return time_points, noisy_data, clean_data\n",
    "    \n",
    "    def fit_all_models(self, time_points, adoption_data):\n",
    "        \"\"\"\n",
    "        Fit all specified models to the data\n",
    "        \"\"\"\n",
    "        self.fitted_models = {}\n",
    "        \n",
    "        for model_name in self.models_to_compare:\n",
    "            try:\n",
    "                if model_name == 'Bass':\n",
    "                    model = BassModel()\n",
    "                elif model_name == 'Logistic':\n",
    "                    model = LogisticModel()\n",
    "                elif model_name == 'Gompertz':\n",
    "                    model = GompertzModel()\n",
    "                else:\n",
    "                    continue\n",
    "                \n",
    "                self.fitter.fit(model, time_points, adoption_data)\n",
    "                self.fitted_models[model_name] = model\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"Failed to fit {model_name} model: {e}\")\n",
    "    \n",
    "    def evaluate_models(self, time_points, adoption_data, validation_points=None, validation_data=None):\n",
    "        \"\"\"\n",
    "        Comprehensive evaluation of all fitted models\n",
    "        \"\"\"\n",
    "        self.evaluation_results = {}\n",
    "        \n",
    "        for model_name, model in self.fitted_models.items():\n",
    "            results = {}\n",
    "            \n",
    "            # Basic fit metrics\n",
    "            try:\n",
    "                fit_metrics = get_fit_metrics(model, time_points, adoption_data)\n",
    "                results.update(fit_metrics)\n",
    "                \n",
    "                # Information criteria\n",
    "                results['AIC'] = model_aic(model, time_points, adoption_data)\n",
    "                results['BIC'] = model_bic(model, time_points, adoption_data)\n",
    "                \n",
    "                # Prediction accuracy\n",
    "                predictions = model.predict(time_points)\n",
    "                results['Mean_Residual'] = np.mean(adoption_data - predictions)\n",
    "                results['Std_Residual'] = np.std(adoption_data - predictions)\n",
    "                \n",
    "                # Out-of-sample validation if provided\n",
    "                if validation_points is not None and validation_data is not None:\n",
    "                    val_predictions = model.predict(validation_points)\n",
    "                    results['Validation_RMSE'] = np.sqrt(mean_squared_error(validation_data, val_predictions))\n",
    "                    results['Validation_R2'] = calculate_r_squared(validation_data, val_predictions)\n",
    "                \n",
    "                # Parameter reasonableness (model-specific checks)\n",
    "                if model_name == 'Bass' and hasattr(model, 'params_'):\n",
    "                    params = model.params_\n",
    "                    results['Parameter_Reasonableness'] = (\n",
    "                        (0.001 <= params.get('p', 0) <= 0.1) and\n",
    "                        (0.1 <= params.get('q', 0) <= 1.0) and\n",
    "                        (params.get('m', 0) > 0)\n",
    "                    )\n",
    "                \n",
    "            except Exception as e:\n",
    "                print(f\"Error evaluating {model_name}: {e}\")\n",
    "                continue\n",
    "            \n",
    "            self.evaluation_results[model_name] = results\n",
    "    \n",
    "    def rank_models(self, criteria_weights=None):\n",
    "        \"\"\"\n",
    "        Rank models based on multiple criteria\n",
    "        \"\"\"\n",
    "        if criteria_weights is None:\n",
    "            criteria_weights = {\n",
    "                'R_squared': 0.3,\n",
    "                'AIC': -0.2,  # Lower is better\n",
    "                'RMSE': -0.2,  # Lower is better\n",
    "                'Parameter_Reasonableness': 0.3\n",
    "            }\n",
    "        \n",
    "        model_scores = {}\n",
    "        \n",
    "        # Normalize metrics for comparison\n",
    "        all_metrics = {}\n",
    "        for criterion in criteria_weights.keys():\n",
    "            values = []\n",
    "            for model_name in self.evaluation_results.keys():\n",
    "                if criterion in self.evaluation_results[model_name]:\n",
    "                    val = self.evaluation_results[model_name][criterion]\n",
    "                    if isinstance(val, bool):\n",
    "                        val = float(val)\n",
    "                    values.append(val)\n",
    "            all_metrics[criterion] = values\n",
    "        \n",
    "        # Calculate weighted scores\n",
    "        for model_name in self.evaluation_results.keys():\n",
    "            score = 0\n",
    "            for criterion, weight in criteria_weights.items():\n",
    "                if criterion in self.evaluation_results[model_name]:\n",
    "                    val = self.evaluation_results[model_name][criterion]\n",
    "                    if isinstance(val, bool):\n",
    "                        val = float(val)\n",
    "                    \n",
    "                    # Normalize value (0-1 scale)\n",
    "                    criterion_values = all_metrics[criterion]\n",
    "                    if len(criterion_values) > 1:\n",
    "                        min_val, max_val = min(criterion_values), max(criterion_values)\n",
    "                        if max_val != min_val:\n",
    "                            normalized_val = (val - min_val) / (max_val - min_val)\n",
    "                        else:\n",
    "                            normalized_val = 1.0\n",
    "                    else:\n",
    "                        normalized_val = 1.0\n",
    "                    \n",
    "                    # Apply weight (negative weights for \"lower is better\" criteria)\n",
    "                    if weight < 0:\n",
    "                        normalized_val = 1 - normalized_val\n",
    "                        weight = abs(weight)\n",
    "                    \n",
    "                    score += weight * normalized_val\n",
    "            \n",
    "            model_scores[model_name] = score\n",
    "        \n",
    "        # Sort by score (descending)\n",
    "        ranked_models = sorted(model_scores.items(), key=lambda x: x[1], reverse=True)\n",
    "        \n",
    "        return ranked_models, model_scores\n",
    "\n",
    "# Initialize comparison framework\n",
    "comparator = ModelComparison()\n",
    "print(\"Model comparison framework initialized\")\n",
    "print(f\"Models to compare: {comparator.models_to_compare}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,

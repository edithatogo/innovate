    "                    'early_stage': ['Logistic', 'Bass'],\n",
    "                    'mature_stage': ['Gompertz']\n",
    "                }\n",
    "            },\n",
    "            'business_context': {\n",
    "                'technology_adoption': ['Bass'],\n",
    "                'market_penetration': ['Logistic'],\n",
    "                'biological_growth': ['Gompertz'],\n",
    "                'competition': ['MultiProduct'],\n",
    "                'replacement_cycle': ['NortonBass']\n",
    "            },\n",
    "            'analysis_requirements': {\n",

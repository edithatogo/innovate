    "# Generate theoretical curves for model comparison\n",
    "def generate_theoretical_curves():\n",
    "    \"\"\"\n",
    "    Generate theoretical curves for all single-product models\n",
    "    \"\"\"\n",
    "    time_points = np.linspace(0.1, 20, 100)\n",
    "    curves = {}\n",
    "    \n",

{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edithatogo/renovate-config",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "baseBranchPatterns": ["main"],
  "schedule": ["* * * * 1"],
  "prCreation": "immediate",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "platformCommit": "enabled",
  "platformAutomerge": true,
  "automergeType": "pr",
  "labels": ["dependencies", "renovate"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/renovate-config\\.yml$/"],
      "matchStrings": ["--package=renovate@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/coverage\\.yml$/"],
      "matchStrings": ["cargo install cargo-llvm-cov --version (?<currentValue>\\d+\\.\\d+\\.\\d+) --locked"],
      "depNameTemplate": "cargo-llvm-cov",
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/coverage\\.yml$/"],
      "matchStrings": ["version: v(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "codecov/codecov-cli",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Group all dev dependencies together",
      "matchDepTypes": ["dev"],
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps"
    },
    {
      "description": "Group all production dependencies together",
      "matchDepTypes": ["dependencies"],
      "groupName": "production dependencies",
      "groupSlug": "prod-deps"
    },
    {
      "description": "Group GitHub Actions updates and require immutable pins",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Auto-merge patch updates after all protected checks pass",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Auto-merge minor development updates after all protected checks pass",
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dev"],
      "automerge": true
    },
    {
      "description": "Keep major updates review-only",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Include changelogs in PR descriptions",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "changelogUrl": "https://github.com/{{depName}}"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": ["security", "dependencies", "renovate"]
  }
}

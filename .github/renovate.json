{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "baseBranches": ["main"],
  "schedule": ["every Monday"],
  "prCreation": "immediate",
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10,
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "automergeType": "pr",
  "labels": ["dependencies", "renovate"],
  "packageRules": [
    {
      "description": "Group all dev dependencies together",
      "matchDepTypes": ["dev"],
      "groupName": "dev dependencies",
      "groupSlug": "dev-deps"
    },
    {
      "description": "Group all production dependencies together",
      "matchDepTypes": ["dependencies"],
      "groupName": "production dependencies",
      "groupSlug": "prod-deps"
    },
    {
      "description": "Group GitHub Actions updates and require immutable pins",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "pinDigests": true
    },
    {
      "description": "Auto-merge patch updates after all protected checks pass",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Auto-merge minor development updates after all protected checks pass",
      "matchUpdateTypes": ["minor", "patch"],
      "matchDepTypes": ["dev"],
      "automerge": true
    },
    {
      "description": "Keep major updates review-only",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "Include changelogs in PR descriptions",
      "matchUpdateTypes": ["major", "minor", "patch"],
      "changelogUrl": "https://github.com/{{depName}}"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": true,
    "labels": ["security", "dependencies", "renovate"]
  }
}
